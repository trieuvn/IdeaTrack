@model IdeaTrack.Areas.SciTech.Models.ReferenceFormEditVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Edit Form"].Value;
    Layout = "~/Areas/SciTech/Views/Shared/_LayoutSciTech.cshtml";
}

<style>
    .premium-form-card {
        background: white;
        border: 1px solid var(--premium-border) !important;
        border-radius: 24px !important;
        box-shadow: 0 12px 40px rgba(0,0,0,0.05) !important;
    }
    .form-label {
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.6rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }
    .form-control, .form-select {
        border-radius: 14px !important;
        border: 1px solid #e2e8f0 !important;
        padding: 0.85rem 1.1rem !important;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: #f8fafc;
        font-weight: 500;
        color: #1e293b;
    }
    .form-control:focus, .form-select:focus {
        background-color: white;
        border-color: var(--brand-red) !important;
        box-shadow: 0 0 0 4px rgba(190, 18, 60, 0.1) !important;
    }
    .btn-brand {
        background-color: var(--brand-red);
        color: white;
        border-radius: 14px;
        font-weight: 600;
        padding: 0.9rem 2.5rem;
        transition: all 0.3s;
        border: none;
    }
    .btn-brand:hover {
        background-color: #9f1239;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(190, 18, 60, 0.2);
    }
    .current-file-badge {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        transition: all 0.3s;
    }
    .current-file-badge:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
    }
    .file-icon-square {
        width: 52px;
        height: 52px;
        background: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        color: var(--brand-red);
        font-size: 1.5rem;
    }
</style>

<div class="container py-2" style="max-width: 900px;">
    <!-- BREADCRUMB -->
    <div class="mb-4">
        <a asp-action="Index" asp-route-periodId="@Model.PeriodId" class="text-decoration-none text-muted fw-bold small d-inline-flex align-items-center opacity-75 hover:opacity-100 transition-opacity">
            <i class="fa-solid fa-chevron-left me-2"></i> @Localizer["Back to Templates"]
        </a>
    </div>

    <!-- HEADER -->
    <div class="mb-5">
        <div class="badge bg-brand-light text-brand px-3 py-2 rounded-pill font-bold small mb-3">
            <i class="fa-solid fa-pen-nib me-2"></i>@Localizer["MODE: EDITING"]
        </div>
        <h2 class="fw-bold font-display text-dark mb-1">@Localizer["Update Template Form"]</h2>
        <p class="text-muted">@Localizer["Modify the details or replace the document file for this template."]</p>
    </div>

    <div class="premium-form-card p-4 p-md-5">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FileUrl" />
            <input type="hidden" asp-for="FileName" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 shadow-sm mb-5 p-3 font-medium"></div>

            <div class="row g-5">
                <!-- FORM INFO -->
                <div class="col-12">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="PeriodId" class="form-label">@Localizer["Active Period"]</label>
                            <select asp-for="PeriodId" asp-items="Model.Periods" class="form-select shadow-none">
                                <option value="">-- @Localizer["Change period..."] --</option>
                            </select>
                            <span asp-validation-for="PeriodId" class="text-danger small mt-2 font-bold d-block"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FormName" class="form-label">@Localizer["Template Title"]</label>
                            <input asp-for="FormName" class="form-control shadow-none" />
                            <span asp-validation-for="FormName" class="text-danger small mt-2 font-bold d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">@Localizer["Description"]</label>
                            <textarea asp-for="Description" class="form-control shadow-none" rows="4"></textarea>
                        </div>
                    </div>
                </div>

                <!-- FILE MANAGEMENT -->
                <div class="col-12">
                    <div class="mb-4">
                        <label class="form-label">@Localizer["Current Document"]</label>
                        <div class="current-file-badge">
                            <div class="file-icon-square">
                                <i class="fa-solid fa-file-invoice"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-dark text-truncate">@(Model.FileName ?? "No filename recorded")</div>
                                <a href="@Model.FileUrl" target="_blank" class="text-rose-600 fw-bold small text-decoration-none hover:text-rose-700">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>@Localizer["Preview Current File"]
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5">
                        <label asp-for="NewFile" class="form-label">@Localizer["Replace with New File (Optional)"]</label>
                        <div class="p-4 rounded-4 border-2 border-dashed text-center bg-slate-50 hover:bg-white hover:border-rose-400 transition-all cursor-pointer" 
                             onclick="document.getElementById('newFileInput').click()">
                            <i class="fa-solid fa-cloud-arrow-up fs-2 text-muted mb-3"></i>
                            <div class="fw-bold text-dark mb-1">@Localizer["Choose a new file to replace"]</div>
                            <div class="text-muted small">@Localizer["PDF, Word, Excel, or PowerPoint (Max 10MB)"]</div>
                            
                            <input id="newFileInput" asp-for="NewFile" type="file" class="d-none" onchange="showNewFile(this)"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" />
                            
                            <div id="newFileInfo" class="mt-3 p-3 bg-white rounded-3 border d-none animate__animated animate__fadeInUp">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <i class="fa-solid fa-file-circle-check text-emerald-500 fs-5"></i>
                                    <span id="newFileNameDisplay" class="fw-bold text-dark"></span>
                                    <button type="button" class="btn btn-sm text-danger p-0 ms-2" onclick="cancelNewFile(event)">
                                        <i class="fa-solid fa-circle-xmark"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="NewFile" class="text-danger small mt-2 font-bold d-block"></span>
                    </div>
                </div>

                <!-- ACTIONS -->
                <div class="col-12 mt-4 border-top pt-4">
                    <div class="d-flex flex-column flex-md-row gap-2">
                        <button type="submit" class="btn btn-brand shadow-sm order-1 order-md-2 px-4">
                            <i class="fa-solid fa-floppy-disk me-2"></i>@Localizer["Save All Changes"]
                        </button>
                        <a asp-action="Index" asp-route-periodId="@Model.PeriodId" class="btn btn-outline-light border font-bold text-slate-500 order-2 order-md-1 px-4 hover:bg-slate-50">
                            @Localizer["Back to List"]
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showNewFile(input) {
            const display = document.getElementById('newFileNameDisplay');
            const info = document.getElementById('newFileInfo');
            if (input.files && input.files.length > 0) {
                display.textContent = input.files[0].name;
                info.classList.remove('d-none');
            } else {
                info.classList.add('d-none');
            }
        }

        function cancelNewFile(e) {
            e.stopPropagation();
            const input = document.getElementById('newFileInput');
            const info = document.getElementById('newFileInfo');
            input.value = '';
            info.classList.add('d-none');
        }
    </script>
}
