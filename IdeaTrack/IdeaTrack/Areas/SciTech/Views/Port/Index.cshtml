@model IdeaTrack.Areas.SciTech.Models.InitiativeReportVM

<!-- HEADER -->
<div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
    <div>
        <h1 class="fw-bold mb-1">@Localizer["Reports & Statistics"]</h1>
        <p class="text-muted mb-0">
            @Localizer["Generate detailed reports, filter data, and export statistics."]
        </p>
    </div>
    <div class="d-flex gap-2">
        <form method="post" action="/SciTech/Port/ExportPdf">
            @Html.AntiForgeryToken()

            <input type="hidden" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="status" value="@Model.Status" />
            <input type="hidden" name="keyword" value="@Model.Keyword" />

            <button type="submit" class="btn btn-outline-secondary">
                <i class="fa-solid fa-print me-1"></i>@Localizer["Print Report (PDF)"]
            </button>
        </form>


        <form method="post" action="/SciTech/Port/ExportExcel">
            @Html.AntiForgeryToken()

            <input type="hidden" name="fromDate"
                   value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="toDate"
                   value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="status" value="@Model.Status" />
            <input type="hidden" name="keyword" value="@Model.Keyword" />

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-download me-1"></i> @Localizer["Export Data"]
            </button>
        </form>


    </div>

</div>

<!-- ==================== DASHBOARD SECTION ==================== -->
<div class="row g-4 mb-4">
    <!-- Info Card: Total Initiatives -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
            <div class="card-body text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 small text-white">@Localizer["Total Initiatives"]</p>
                        <h2 class="fw-bold mb-0">@ViewBag.TotalInitiativesCount</h2>
                    </div>
                    <i class="fa-solid fa-lightbulb fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Info Card: Open Periods -->
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%) !important;">
            <div class="card-body text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="mb-1 small text-white">@Localizer["Open Periods"]</p>
                        <h2 class="fw-bold mb-0">@ViewBag.OpenPeriodsCount</h2>
                    </div>
                    <i class="fa-solid fa-calendar-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Chart: Audit Logs Per Day -->
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="fa-solid fa-chart-column text-primary me-2"></i>@Localizer["Activity Log (Last 7 Days)"]</h6>
            </div>
            <div class="card-body">
                <canvas id="auditLogsChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation me-1"></i>
        @ViewBag.ErrorMessage
    </div>
}

<!-- STATS -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-start border-4 border-info">
            <div class="card-body">
                <i class="fa-solid fa-list-check text-info fs-4"></i>
                <p class="text-muted small mb-1">@Localizer["Faculty Approved"]</p>
                <h3 class="fw-bold mb-0">@ViewBag.FacultyApprovedCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-start border-4 border-primary">
            <div class="card-body">
                <i class="fa-solid fa-spinner text-primary fs-4"></i>
                <p class="text-muted small mb-1">@Localizer["Evaluating"]</p>
                <h3 class="fw-bold mb-0">@ViewBag.EvaluatingCount</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-start border-4 border-warning">
            <div class="card-body">
                <i class="fa-solid fa-hourglass-half text-warning fs-4"></i>
                <p class="text-muted small mb-1">@Localizer["Pending Final"]</p>
                <h3 class="fw-bold mb-0">@ViewBag.PendingFinalCount</h3>
            </div>
        </div>
    </div>
</div>

<!-- FILTER -->
<form method="get" class="row g-3 mb-4">
    <input type="hidden" name="page" value="1" />

    <div class="col-md-3">
        <label class="form-label">@Localizer["Year"]</label>
        <select name="yearId" class="form-select">
            <option value="">@Localizer["All"]</option>
            @foreach (var y in Model.Years)
            {
                <option value="@y.Value" selected="@(y.Value == Model.YearId?.ToString())">@y.Text</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["Period"]</label>
        <select name="periodId" class="form-select">
            <option value="">@Localizer["All"]</option>
            @foreach (var p in Model.Periods)
            {
                <option value="@p.Value" selected="@(p.Value == Model.PeriodId?.ToString())">@p.Text</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["Category"]</label>
        <select name="categoryId" class="form-select">
            <option value="">@Localizer["All"]</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.Value" selected="@(c.Value == Model.CategoryId?.ToString())">@c.Text</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["Status"]</label>
        <select name="status" class="form-select">
            <option value="">@Localizer["All"]</option>
            <option value="Faculty_Approved" selected="@(Model.Status == "Faculty_Approved")">@Localizer["Faculty Approved"]</option>
            <option value="Evaluating" selected="@(Model.Status == "Evaluating")">@Localizer["Evaluating"]</option>
            <option value="Re_Evaluating" selected="@(Model.Status == "Re_Evaluating")">@Localizer["Re-evaluating"]</option>
            <option value="Pending_Final" selected="@(Model.Status == "Pending_Final")">@Localizer["Pending Final"]</option>
            <option value="Approved" selected="@(Model.Status == "Approved")">@Localizer["Approved"]</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["From Date"]</label>
        <input type="date" name="fromDate" class="form-control"
               value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["To Date"]</label>
        <input type="date" name="toDate" class="form-control"
               value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-3">
        <label class="form-label">@Localizer["Keyword"]</label>
        <input name="keyword"
               class="form-control"
               value="@Model.Keyword"
               placeholder="@Localizer["Code / Title"]" />
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button class="btn btn-primary flex-grow-1">
            <i class="fa-solid fa-filter me-1"></i>@Localizer["Apply"]
        </button>
        <a href="/SciTech/Port" class="btn btn-outline-secondary">
            <i class="fa-solid fa-rotate-left"></i>
        </a>
    </div>
</form>

<!-- TABLE -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Code"]</th>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Year/Period"]</th>
                    <th>@Localizer["Author"]</th>
                    <th>@Localizer["Department"]</th>
                    <th>@Localizer["Status"]</th>
                    <th class="text-end">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            @Localizer["No data available"]
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.InitiativeCode</td>
                            <td>
                                <div>@item.Title</div>
                                <small class="text-muted"><i class="fa-regular fa-clock me-1"></i>@item.SubmittedDate?.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <div class="badge bg-light text-dark border">@item.AcademicYear</div>
                                <div class="small text-muted mt-1">@item.PeriodName</div>
                            </td>
                            <td>
                                <div>@item.ProposerName</div>
                                @if (item.MemberCount > 1)
                                {
                                    <small class="text-muted">(@item.MemberCount @Localizer["members"])</small>
                                }
                            </td>
                            <td>@item.DepartmentName</td>
                            <td>
                                @{
                                    string badgeClass = "bg-secondary";
                                    string label = item.Status;

                                    switch (item.Status)
                                    {
                                        case "Approved":
                                            badgeClass = "bg-success";
                                            break;
                                        case "Rejected":
                                            badgeClass = "bg-danger";
                                            break;
                                        case "Pending":
                                            badgeClass = "bg-warning text-dark";
                                            break;
                                        case "Faculty_Approved":
                                            badgeClass = "bg-info text-white";
                                            label = Localizer["Faculty Approved"].Value;
                                            break;
                                        case "Evaluating":
                                            badgeClass = "bg-primary";
                                            break;
                                        case "Re_Evaluating":
                                            badgeClass = "bg-primary";
                                            label = Localizer["Re-evaluating"].Value;
                                            break;
                                        case "Pending_Final":
                                            badgeClass = "bg-warning text-dark";
                                            label = Localizer["Pending Final"].Value;
                                            break;
                                        case "Revision_Required":
                                            badgeClass = "bg-warning text-dark";
                                            label = Localizer["Revision Required"].Value;
                                            break;
                                        case "Draft":
                                            badgeClass = "bg-secondary";
                                            break;
                                    }
                                }
                                <span class="badge @badgeClass rounded-pill">@label</span>
                            </td>
                            <td class="text-end">
                                @{
                                    var resultStatuses = new[] { "Evaluating", "Re_Evaluating", "Pending_Final", "Approved", "Rejected" };
                                    var action = resultStatuses.Contains(item.Status) ? "Result" : "Approve";
                                    var btnClass = action == "Result" ? "btn-outline-primary" : "btn-primary";
                                    var icon = action == "Result" ? "fa-chart-bar" : "fa-eye";
                                    var title = action == "Result" ? Localizer["View Result"].Value : Localizer["View Detail"].Value;
                                }
                                <a href="/SciTech/Port/@action/@item.Id" class="btn btn-sm @btnClass" title="@title">
                                    <i class="fas @icon"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    <div class="card-footer d-flex justify-content-between align-items-center">
        @{
            var start = (Model.CurrentPage - 1) * 5 + 1;
            var end = Math.Min(Model.CurrentPage * 5, Model.TotalItems);
        }
        <small class="text-muted">
            @string.Format(Localizer["Showing {0}-{1} / {2} initiatives"].Value, start, end, Model.TotalItems)
        </small>

        <nav>
            <ul class="pagination pagination-sm mb-0">
               @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action(
                               "Index",
                               "Port",
                               new {
                                   area = "SciTech",
                                   page = i,
                                   fromDate = Model.FromDate,
                                   toDate = Model.ToDate,
                                   status = Model.Status,
                                   keyword = Model.Keyword,
                                   periodId = Model.PeriodId,
                                   categoryId = Model.CategoryId,
                                   yearId = Model.YearId
                               })">
                            @i
                        </a>
                    </li>
                }


            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var ctx = document.getElementById('auditLogsChart').getContext('2d');
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels ?? new List<string>()));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData ?? new List<int>()));
            
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: '@Localizer["Number of activities"]',
                        data: data,
                        backgroundColor: 'rgba(54, 162, 235, 0.7)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        });
    </script>
}
