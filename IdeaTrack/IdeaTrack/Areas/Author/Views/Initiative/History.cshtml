@model IEnumerable<IdeaTrack.Models.Initiative>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<main class="container pb-5 pt-2">

    <!-- Hero Section -->
    <section class="hero-section text-white p-4 mb-4 shadow" style="border-radius: 15px; min-height: auto;">
        <div class="row">
            <div class="col-lg-8">
                <span class="badge rounded-pill bg-info bg-opacity-25 text-info mb-2 p-2 px-3" style="border: 1px solid rgba(0,255,255,0.2)">
                    <span class="material-icons align-middle me-1" style="font-size: 16px;">history</span> INITIATIVE HISTORY
                </span>
                <h1 class="fw-bold display-6 mb-2">@Localizer["Activity History"]</h1>
                <p class="fs-6 mb-0 opacity-75" style="line-height: 1.6;">
                    @Localizer["Activity History Description"]
                </p>
            </div>
            <div class="col-lg-4 d-flex align-items-center justify-content-end">
                <div class="text-center">
                    <div class="display-4 fw-bold">@Model.Count()</div>
                    <div class="opacity-75">@Localizer["Total Initiatives"]</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Search and Filter Form -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" action="@Url.Action("History")" class="row g-3">
                <!-- Year -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">@Localizer["Year"]</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-calendar"></i></span>
                        <select id="yearSelect" name="yearId" class="form-select border-start-0 ps-0" asp-items="ViewBag.Years">
                            <option value="">-- @Localizer["All Years"] --</option>
                        </select>
                    </div>
                </div>

                <!-- Period -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">@Localizer["Period"]</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-clock"></i></span>
                        <select id="periodSelect" name="periodId" class="form-select border-start-0 ps-0" asp-items="ViewBag.Periods">
                            <option value="">-- @Localizer["All Periods"] --</option>
                        </select>
                    </div>
                </div>

                <!-- Category -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">@Localizer["Category"]</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-tags"></i></span>
                        <select id="categorySelect" name="categoryId" class="form-select border-start-0 ps-0" asp-items="ViewBag.Categories">
                            <option value="">-- @Localizer["All Categories"] --</option>
                        </select>
                    </div>
                </div>

                <!-- Status -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">@Localizer["Status"]</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-flag"></i></span>
                        <select name="statusFilter" class="form-select border-start-0 ps-0 text-capitalize">
                            <option value="">-- @Localizer["All Statuses"] --</option>
                            @foreach (var status in Enum.GetValues(typeof(IdeaTrack.Models.InitiativeStatus)).Cast<IdeaTrack.Models.InitiativeStatus>())
                            {
                                var statusName = status.ToString().Replace("_", " ");
                                string translatedName = status switch
                                {
                                    IdeaTrack.Models.InitiativeStatus.Draft => "Bản nháp",
                                    IdeaTrack.Models.InitiativeStatus.Pending => "Chờ xét duyệt",
                                    IdeaTrack.Models.InitiativeStatus.Faculty_Approved => "Khoa đã duyệt",
                                    IdeaTrack.Models.InitiativeStatus.Evaluating => "Đang đánh giá",
                                    IdeaTrack.Models.InitiativeStatus.Re_Evaluating => "Đang chấm lại",
                                    IdeaTrack.Models.InitiativeStatus.Revision_Required => "Yêu cầu chỉnh sửa",
                                    IdeaTrack.Models.InitiativeStatus.Processing => "Đang xử lý",
                                    IdeaTrack.Models.InitiativeStatus.Pending_Final => "Chờ chung khảo",
                                    IdeaTrack.Models.InitiativeStatus.Approved => "Đã duyệt",
                                    IdeaTrack.Models.InitiativeStatus.Rejected => "Đã từ chối",
                                    IdeaTrack.Models.InitiativeStatus.Rejected_SL => "Từ chối (Hội đồng)",
                                    _ => statusName
                                };

                                if (ViewBag.CurrentStatus != null && ViewBag.CurrentStatus == status)
                                {
                                    <option value="@status" selected>@translatedName</option>
                                }
                                else
                                {
                                    <option value="@status">@translatedName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Actions -->
                <div class="col-12 mt-3 text-end">
                    <a href="@Url.Action("History")" class="btn btn-light rounded-pill px-4 me-2">
                        <i class="fa-solid fa-rotate-left me-1"></i> @Localizer["Reset"]
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fa-solid fa-filter me-1"></i> @Localizer["Filter"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- History Table with DataTables -->
    <div class="card shadow-sm" style="border-radius: 15px; border: 1px solid rgba(37, 99, 235, 0.12);">
        <div class="card-header bg-white py-3" style="border-radius: 15px 15px 0 0; border-bottom: 1px solid rgba(37, 99, 235, 0.1);">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-primary">
                    <span class="material-icons align-middle me-2" style="font-size: 20px;">list_alt</span>
                    @Localizer["Initiative List"]
                </h5>
                <a asp-controller="Initiative" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                    <span class="material-icons align-middle me-1" style="font-size: 16px;">add</span> @Localizer["New Initiative"]
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive p-3">
                    <table id="basic-datatables" class="display table table-striped table-hover align-middle" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">
                                    <span class="material-icons align-middle me-1" style="font-size: 16px;">title</span>
                                    @Localizer["Title"]
                                </th>
                                <th>
                                    <span class="material-icons align-middle me-1" style="font-size: 16px;">category</span>
                                    @Localizer["Category"]
                                </th>
                                <th>
                                    <span class="material-icons align-middle me-1" style="font-size: 16px;">event</span>
                                    @Localizer["Created Date"]
                                </th>
                                <th>
                                    <span class="material-icons align-middle me-1" style="font-size: 16px;">flag</span>
                                    @Localizer["Status"]
                                </th>
                                <th class="text-end pe-3">
                                    <span class="material-icons align-middle me-1" style="font-size: 16px;">settings</span>
                                    @Localizer["Actions"]
                                </th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Created Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </tfoot>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-semibold text-dark">@item.Title</div>
                                        <div class="text-muted small text-truncate" style="max-width: 280px;">
                                            @(string.IsNullOrEmpty(item.Description) ? "No description" : (item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description))
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark rounded-pill border">
                                            @(item.Category?.Name ?? "Uncategorized")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center text-muted">
                                            <span class="material-icons me-1" style="font-size: 14px;">calendar_today</span>
                                            @item.CreatedAt.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case IdeaTrack.Models.InitiativeStatus.Approved:
                                                <span class="badge bg-success rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">check_circle</span> Đã duyệt
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Rejected:
                                                <span class="badge bg-danger rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">cancel</span> Đã từ chối
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Rejected_SL:
                                                <span class="badge bg-danger rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">block</span> Từ chối (Hội đồng)
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Draft:
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">edit_note</span> Bản nháp
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Processing:
                                                <span class="badge bg-info rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">hourglass_top</span> Đang xử lý
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Pending:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">schedule</span> Chờ xét duyệt
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Evaluating:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">assignment</span> Đang đánh giá
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Faculty_Approved:
                                                <span class="badge bg-success bg-opacity-75 text-white rounded-pill px-3 py-2" style="background-color: #198754 !important;">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">thumb_up</span> Khoa đã duyệt
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Revision_Required:
                                                <span class="badge bg-info text-white rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">rate_review</span> Yêu cầu chỉnh sửa
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Pending_Final:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">gavel</span> Chờ chung khảo
                                                </span>
                                                break;
                                            case IdeaTrack.Models.InitiativeStatus.Re_Evaluating:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                                    <span class="material-icons align-middle me-1" style="font-size: 12px;">assignment_returned</span> Đang chấm lại
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark rounded-pill px-3 py-2">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Initiative" asp-action="Detail" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-outline-primary rounded-start-pill" title="View Details">
                                                <span class="material-icons" style="font-size: 16px;">visibility</span>
                                            </a>
                                            @if (item.Status == IdeaTrack.Models.InitiativeStatus.Draft || item.Status == IdeaTrack.Models.InitiativeStatus.Revision_Required || item.Status == IdeaTrack.Models.InitiativeStatus.Rejected_SL)
                                            {
                                                <a asp-controller="Initiative" asp-action="Edit" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-outline-secondary rounded-end-pill" title="Edit Initiative">
                                                    <span class="material-icons" style="font-size: 16px;">edit</span>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <span class="material-icons text-muted" style="font-size: 80px;">inbox</span>
                    </div>
                    <h5 class="text-muted mb-2">@Localizer["No initiatives found"]</h5>
                    <p class="text-muted mb-4">@Localizer["Start by creating your first initiative"]</p>
                    <a asp-controller="Initiative" asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">
                        <span class="material-icons align-middle me-1">add_circle</span> @Localizer["Create New Initiative"]
                    </a>
                </div>
            }
        </div>
    </div>

</main>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Dynamic dropdowns submission
            $('#yearSelect').change(function() {
                $('#periodSelect').val('');
                $('#categorySelect').val('');
                $(this).closest('form').submit();
            });

            $('#periodSelect').change(function() {
                $('#categorySelect').val('');
                $(this).closest('form').submit();
            });
        });
    </script>
}
