@model IdeaTrack.ViewModels.PrivacyViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Initiative Submission Guide"];
}

<main class="container pb-5 pt-2">
    <div class="row g-4">
        <div class="col-lg-8">
            <header class="mb-5">
                <h1 class="fw-bold text-dark">@Localizer["Initiative Submission Guide"]</h1>
                <p class="text-secondary fs-5">
                    @Localizer["Privacy Description"]
                </p>
            </header>

            <section class="card border-0 shadow-sm rounded-4 mb-5" style="background-color: #fdfdfd; border-left: 5px solid #d32f2f !important;">
                <div class="card-body p-4">
                    <h5 class="fw-bold d-flex align-items-center mb-3">
                        <span class="badge bg-danger rounded-circle me-2 p-1" style="width: 24px; height: 24px; display: inline-block; font-size: 12px;">i</span>
                        @Localizer["Overview"]
                    </h5>
                    <p class="text-muted mb-0">
                        @Localizer["Overview Detail"]
                    </p>
                </div>
            </section>

            <section>
                <h3 class="fw-bold mb-4">@Localizer["Submission Process"]</h3>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                            <div class="mb-3">
                                <span class="badge bg-danger-subtle text-danger rounded-3 px-3 py-2 fw-bold">1</span>
                            </div>
                            <h6 class="fw-bold">@Localizer["Prepare Documents"]</h6>
                            <p class="small text-muted mb-0">@Localizer["Prepare Documents Detail"]</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                            <div class="mb-3">
                                <span class="badge bg-danger-subtle text-danger rounded-3 px-3 py-2 fw-bold">2</span>
                            </div>
                            <h6 class="fw-bold">@Localizer["Submit Online"]</h6>
                            <p class="small text-muted mb-0">@Localizer["Submit Online Detail"]</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                            <div class="mb-3">
                                <span class="badge bg-danger-subtle text-danger rounded-3 px-3 py-2 fw-bold">3</span>
                            </div>
                            <h6 class="fw-bold">@Localizer["Council Review"]</h6>
                            <p class="small text-muted mb-0">@Localizer["Council Review Detail"]</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                            <div class="mb-3">
                                <span class="badge bg-danger-subtle text-danger rounded-3 px-3 py-2 fw-bold">4</span>
                            </div>
                            <h6 class="fw-bold">@Localizer["Recognition & Awards"]</h6>
                            <p class="small text-muted mb-0">@Localizer["Recognition Awards Detail"]</p>
                        </div>
                    </div>
                </div>
            </section>
            <section class="mt-5">
                <h3 class="fw-bold mb-4">@Localizer["Document Requirements"]</h3>
                <div class="table-responsive bg-white rounded-4 shadow-sm p-3">
                    <table class="table table-borderless align-middle">
                        <thead class="border-bottom">
                            <tr>
                                <th class="text-muted small text-uppercase">@Localizer["Document Type"]</th>
                                <th class="text-muted small text-uppercase">@Localizer["Format"]</th>
                                <th class="text-muted small text-uppercase">@Localizer["Notes"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="fw-bold">@Localizer["Initiative Registration Form"]</div>
                                    <div class="small text-muted">Form M01</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">PDF/DOCX</span></td>
                                <td class="small text-muted">@Localizer["Must include author's signature"]</td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="fw-bold">@Localizer["Initiative Description"]</div>
                                    <div class="small text-muted">Form M02</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">PDF</span></td>
                                <td class="small text-muted">@Localizer["Content should not exceed 20 pages"]</td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="fw-bold">@Localizer["Supporting Evidence"]</div>
                                    <div class="small text-muted">@Localizer["Photos, videos, data..."]</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">ZIP/RAR</span></td>
                                <td class="small text-muted">@Localizer["Compress all documents if file size is large"]</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="mt-5 mb-5">
                <h3 class="fw-bold mb-4">@Localizer["Frequently Asked Questions"]</h3>
                <style>
                    /* Fix conflict between Bootstrap and Tailwind CSS on '.collapse' class */
                    .accordion-collapse.collapse {
                        visibility: visible !important;
                    }

                    /* Premium smooth transition */
                    .accordion-collapse {
                        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;
                    }

                    /* Custom fade-in for content that syncs with expansion */
                    .accordion-body {
                        transition: all 0.5s ease-out;
                        opacity: 0;
                        transform: translateY(-10px);
                    }

                    .accordion-collapse.show .accordion-body {
                        opacity: 1;
                        transform: translateY(0);
                    }

                    .accordion-button:not(.collapsed) {
                        background-color: #fef2f2 !important;
                        color: #b91c1c !important;
                        box-shadow: none !important;
                    }
                </style>
                <div class="accordion accordion-flush notranslate" id="faqAccordion">
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-4">
                        <h2 class="accordion-header" id="headingFaq1">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="false" aria-controls="faq1">
                                @Localizer["Q1_Question"]
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse" aria-labelledby="headingFaq1" data-bs-parent="#faqAccordion">
                            <div class="accordion-body notranslate">
                                <p class="mb-0 fw-normal" style="color: #444 !important; opacity: 1 !important; visibility: visible !important;">@Localizer["Q1_Answer"]</p>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-4">
                        <h2 class="accordion-header" id="headingFaq2">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                                @Localizer["Q2_Question"]
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" aria-labelledby="headingFaq2" data-bs-parent="#faqAccordion">
                            <div class="accordion-body notranslate">
                                <p class="mb-0 fw-normal" style="color: #444 !important; opacity: 1 !important; visibility: visible !important;">@Localizer["Q2_Answer"]</p>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-4">
                        <h2 class="accordion-header" id="headingFaq3">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                                @Localizer["Q3_Question"]
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" aria-labelledby="headingFaq3" data-bs-parent="#faqAccordion">
                            <div class="accordion-body notranslate">
                                <p class="mb-0 fw-normal" style="color: #444 !important; opacity: 1 !important; visibility: visible !important;">@Localizer["Q3_Answer"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <!-- Year/Period Filter Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-danger bg-opacity-10 p-2 rounded-3 me-3">
                            <i class="bi bi-calendar-check text-danger fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">@Localizer["Select Period"]</h5>
                    </div>
                    <p class="small text-muted mb-3">@Localizer["Select Period Description"]</p>
                    
                    <div class="mb-3">
                        <label class="form-label small text-muted text-uppercase fw-bold">@Localizer["Academic Year"]</label>
                        <select class="form-select" id="yearSelect">
                            @if (Model.AvailableYears.Any())
                            {
                                @foreach (var year in Model.AvailableYears)
                                {
                                    if (year.Id == Model.SelectedYearId)
                                    {
                                        <option value="@year.Id" selected>@year.Name @(year.IsCurrent ? Localizer["(Current)"].Value : "")</option>
                                    }
                                    else
                                    {
                                        <option value="@year.Id">@year.Name @(year.IsCurrent ? Localizer["(Current)"].Value : "")</option>
                                    }
                                }
                            }
                            else
                            {
                                <option value="">@Localizer["No active years available"]</option>
                            }
                        </select>
                    </div>
                    
                    <div class="mb-0">
                        <label class="form-label small text-muted text-uppercase fw-bold">@Localizer["Initiative Period"]</label>
                        <select class="form-select" id="periodSelect">
                            @if (Model.AvailablePeriods.Any())
                            {
                                @foreach (var period in Model.AvailablePeriods)
                                {
                                    if (period.Id == Model.SelectedPeriodId)
                                    {
                                        <option value="@period.Id" selected>@period.Name @(period.IsActive ? Localizer["(Active)"].Value : "")</option>
                                    }
                                    else
                                    {
                                        <option value="@period.Id">@period.Name @(period.IsActive ? Localizer["(Active)"].Value : "")</option>
                                    }
                                }
                            }
                            else
                            {
                                <option value="">@Localizer["No active periods"]</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Support Documents Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3">
                            <i class="bi bi-folder2-open text-primary fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">@Localizer["Support Documents"]</h5>
                    </div>
                    <p class="small text-muted mb-3">
                        @if (!string.IsNullOrEmpty(Model.SelectedPeriodName))
                        {
                            <span>@Localizer["Documents for:"] <strong class="text-danger">@Model.SelectedPeriodName</strong></span>
                        }
                        else
                        {
                            <span>@Localizer["Download forms and guides"]</span>
                        }
                    </p>

                    <div class="list-group list-group-flush mb-4" id="documentsList">
                        @if (Model.ReferenceForms.Any())
                        {
                            @foreach (var form in Model.ReferenceForms)
                            {
                                var iconClass = form.FileType?.ToLower() switch
                                {
                                    "pdf" => "bi-file-earmark-pdf-fill text-danger",
                                    "docx" or "doc" => "bi-file-earmark-word-fill text-primary",
                                    "xlsx" or "xls" => "bi-file-earmark-excel-fill text-success",
                                    _ => "bi-file-earmark-fill text-secondary"
                                };
                                
                                <div class="list-group-item d-flex align-items-center border-0 px-0 mb-2">
                                <!-- Icon chính -->
                                <i class="bi @iconClass fs-4 me-3"></i>

                                <!-- Nội dung text -->
                                <div class="flex-grow-1">
                                    <div class="small fw-bold text-dark text-truncate">@form.FormName</div>
                                    <div class="text-muted" style="font-size: 11px;">@(form.FileType?.ToUpper() ?? "FILE")</div>
                                </div>

                                <!-- Hành động -->
                                <div class="d-flex align-items-center">
                                    <!-- Download -->
                                    <a href="@Url.Action("DownloadDocument", new { id = form.Id })"
                                       target="_blank"
                                       download
                                       data-ajax="false"
                                       class="btn btn-sm btn-light me-2"
                                       title="Tải xuống">
                                        <i class="bi bi-download"></i>
                                    </a>

                                    <!-- Xem -->
                                    <a href="/viewer-page?file=@Uri.EscapeDataString(form.FileName)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-sm btn-light"
                                       title="Xem tài liệu">
                                        <i class="bi bi-eye text-muted"></i>
                                    </a>
                                </div>
                            </div>

                               
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-folder-x text-muted" style="font-size: 48px;"></i>
                                <p class="text-muted mt-2 mb-0">@Localizer["No documents available for this period."]</p>
                            </div>
                        }
                    </div>

                    @if (Model.ReferenceForms.Any() && Model.SelectedPeriodId.HasValue)
                    {
                        <a href="@Url.Action("DownloadAllDocuments", new { periodId = Model.SelectedPeriodId })"
                           class="btn btn-outline-danger w-100 rounded-pill fw-bold py-2">
                            <i class="bi bi-file-earmark-zip me-2"></i>@Localizer["Download All (.zip)"]
                        </a>
                    }
                </div>
            </div>

            <!-- Current Status Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-danger bg-opacity-10">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-danger text-uppercase small mb-3">@Localizer["Current Status"]</h6>
                    @if (Model.ActivePeriodInfo != null)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-success p-2 me-2 ripple-animation">●</span>
                            <span class="fw-bold text-dark">@Model.ActivePeriodInfo.PeriodName</span>
                        </div>
                        <p class="small text-muted mb-0">
                            @Localizer["Deadline:"] <strong>@Model.ActivePeriodInfo.EndDate.ToString("dd/MM/yyyy")</strong> 
                            (@Model.ActivePeriodInfo.DaysRemaining @Localizer["days remaining"])
                        </p>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-secondary p-2 me-2">●</span>
                            <span class="fw-bold text-dark">@Localizer["No Active Period"]</span>
                        </div>
                        <p class="small text-muted mb-0">@Localizer["No active period description"]</p>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark text-uppercase small mb-3">@Localizer["Need Help?"]</h6>
                    <div class="d-flex align-items-start mb-3">
                        <i class="bi bi-telephone text-primary me-3"></i>
                        <div>
                            <div class="small fw-bold">@Localizer["Science & Technology Office"]</div>
                            <div class="small text-muted">(028) 38.XXX.XXX (Ext: 102)</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start mb-0">
                        <i class="bi bi-envelope text-primary me-3"></i>
                        <div>
                            <div class="small fw-bold">@Localizer["Support Email"]</div>
                            <div class="small text-muted">scitech@university.edu.vn</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning border-0 rounded-4 p-4 shadow-sm" role="alert">
                <h6 class="alert-heading fw-bold d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @Localizer["Important Notice"]
                </h6>
                <p class="small mb-0 text-dark">@Localizer["Late submission notice"]</p>
            </div>
        </div>
    </div>
</main>

@section Scripts {
<script>
    document.getElementById('yearSelect').addEventListener('change', function() {
        var yearId = this.value;
        window.location.href = '@Url.Action("Privacy")' + '?yearId=' + yearId;
    });

    document.getElementById('periodSelect').addEventListener('change', function() {
        var periodId = this.value;
        var yearId = document.getElementById('yearSelect').value;
        window.location.href = '@Url.Action("Privacy")' + '?yearId=' + yearId + '&periodId=' + periodId;
    });
</script>
}
