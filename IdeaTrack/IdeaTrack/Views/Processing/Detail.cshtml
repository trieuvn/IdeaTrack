@using IdeaTrack.Models
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Initiative

@{
    ViewData["Title"] = @Localizer["Initiative Detail"].Value;
    var isApprover = (bool)(ViewBag.IsApprover ?? false);
    var latestRevisionRequest = ViewBag.LatestRevisionRequest as RevisionRequest;
}

<div class="container-fluid px-md-5 py-4">
    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <span class="material-icons text-primary me-2" style="vertical-align:middle;">description</span>
                @Model.Title
            </h2>
            <p class="text-muted mb-0">
                @Localizer["Code"]: <span class="fw-semibold">@Model.InitiativeCode</span>
                | @Localizer["Department"]: <span class="fw-semibold">@Model.Department?.Name</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Processing" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> @Localizer["Back"]
            </a>

            @if (isApprover && Model.Status == InitiativeStatus.Processing)
            {
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">
                    <i class="fa-solid fa-check me-1"></i> @Localizer["Approve"]
                </button>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="fa-solid fa-times me-1"></i> @Localizer["Reject"]
                </button>
            }
            @if (isApprover && Model.Status == InitiativeStatus.Approved)
            {
                <button type="button" class="btn btn-warning text-white" data-bs-toggle="modal" data-bs-target="#revokeModal">
                    <i class="fa-solid fa-rotate-left me-1"></i> @Localizer["Revoke Approval"]
                </button>
            }
            @if (isApprover && Model.Status == InitiativeStatus.Rejected_SL)
            {
                <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#undoRejectModal">
                    <i class="fa-solid fa-undo me-1"></i> @Localizer["Undo Reject"]
                </button>
            }
        </div>
    </div>

    <!-- SUCCESS / ERROR MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- LEFT: MAIN INFO -->
        <div class="col-lg-8">
            <!-- STATUS CARD -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase">@Localizer["Status"]</small>
                            @{
                                string statusBg, statusLabel;
                                if (Model.Status == InitiativeStatus.Approved)
                                {
                                    statusBg = "bg-success";
                                    statusLabel = @Localizer["Approved"].Value;
                                }
                                else if (Model.Status == InitiativeStatus.Rejected_SL)
                                {
                                    statusBg = "bg-danger";
                                    statusLabel = @Localizer["Rejected (SL)"].Value;
                                }
                                else
                                {
                                    statusBg = "bg-info";
                                    statusLabel = @Localizer["Processing"].Value;
                                }
                            }
                            <div class="mt-1">
                                <span class="badge @statusBg fs-6 px-3 py-2">@statusLabel</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase">@Localizer["Category"]</small>
                            <div class="fw-semibold mt-1">@(Model.Category?.Name ?? "N/A")</div>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted text-uppercase">@Localizer["Period"]</small>
                            <div class="fw-semibold mt-1">@(Model.Period?.Name ?? "N/A")</div>
                            <small class="text-muted">@(Model.Period?.AcademicYear?.Name ?? "")</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- REJECTION INFO (for Rejected_SL) -->
            @if (Model.Status == InitiativeStatus.Rejected_SL && latestRevisionRequest != null)
            {
                <div class="card shadow-sm mb-4 border-danger" style="border-width: 2px;">
                    <div class="card-header bg-danger bg-opacity-10 fw-bold text-danger">
                        <i class="fa-solid fa-ban me-2"></i> @Localizer["Rejection Information"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <small class="text-muted">@Localizer["Reason"]</small>
                            <div style="white-space: pre-wrap;">@latestRevisionRequest.RequestContent</div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <small class="text-muted">@Localizer["Rejected by"]</small>
                                <div class="fw-semibold">@(latestRevisionRequest.Requester?.FullName ?? "N/A")</div>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted">@Localizer["Date"]</small>
                                <div class="fw-semibold">@latestRevisionRequest.RequestedDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            @if (latestRevisionRequest.Status == "Open" && latestRevisionRequest.Deadline.HasValue)
                            {
                                <div class="col-md-4">
                                    <small class="text-muted">@Localizer["Resubmit Deadline"]</small>
                                    <div class="fw-semibold text-danger">
                                        @latestRevisionRequest.Deadline.Value.ToString("dd/MM/yyyy")
                                        @if (latestRevisionRequest.Deadline.Value < DateTime.Now)
                                        {
                                            <span class="badge bg-danger ms-1">@Localizer["Expired"]</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        @if (latestRevisionRequest.Status == "Closed")
                        {
                            <div class="alert alert-warning mt-3 mb-0">
                                <i class="fa-solid fa-lock me-1"></i> @Localizer["Resubmission is not allowed for this rejection."]
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- DESCRIPTION -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-light fw-bold">
                    <i class="fa-solid fa-file-lines me-2"></i> @Localizer["Description"]
                </div>
                <div class="card-body">
                    <div style="white-space: pre-wrap;">@(Model.Description ?? @Localizer["No description provided."].Value)</div>
                </div>
            </div>

            <!-- BUDGET -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-light fw-bold">
                    <i class="fa-solid fa-coins me-2"></i> @Localizer["Budget"]
                </div>
                <div class="card-body">
                    <h4 class="text-primary fw-bold mb-0">@Model.Budget.ToString("N0") VNĐ</h4>
                </div>
            </div>

            <!-- FILES -->
            @if (Model.Files != null && Model.Files.Any())
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light fw-bold">
                        <i class="fa-solid fa-paperclip me-2"></i> @Localizer["Attached Files"]
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            @foreach (var file in Model.Files)
                            {
                                <a href="@file.FilePath" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" target="_blank">
                                    <span>
                                        <i class="fa-solid fa-file me-2 text-muted"></i>
                                        @file.FileName
                                    </span>
                                    <span class="badge bg-secondary">@file.FileType</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: SIDEBAR INFO -->
        <div class="col-lg-4">
            <!-- AUTHORS -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-light fw-bold">
                    <i class="fa-solid fa-users me-2"></i> @Localizer["Authors"]
                </div>
                <div class="card-body">
                    @if (Model.Authorships != null)
                    {
                        foreach (var authorship in Model.Authorships)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white" style="width:36px;height:36px;font-size:0.8rem;">
                                    @(authorship.Author?.FullName?.Substring(0, 1) ?? "?")
                                </div>
                                <div>
                                    <div class="fw-semibold">@(authorship.Author?.FullName ?? "N/A")</div>
                                    <small class="text-muted">@(authorship.IsCreator ? @Localizer["Creator"].Value : @Localizer["Co-author"].Value)</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- FINAL RESULT -->
            @if (Model.FinalResult != null)
            {
                <div class="card shadow-sm mb-4 border-0">
                    <div class="card-header bg-light fw-bold">
                        <i class="fa-solid fa-trophy me-2"></i> @Localizer["Evaluation Result"]
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <small class="text-muted">@Localizer["Average Score"]</small>
                            <h5 class="text-primary fw-bold">@Model.FinalResult.AverageScore.ToString("0.0")</h5>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">@Localizer["Rank"]</small>
                            <div class="fw-semibold">@Model.FinalResult.Rank</div>
                        </div>
                        <div>
                            <small class="text-muted">@Localizer["Decided by"]</small>
                            <div class="fw-semibold">@(Model.FinalResult.Chairman?.FullName ?? "N/A")</div>
                            <small class="text-muted">@Model.FinalResult.DecisionDate.ToString("dd/MM/yyyy")</small>
                        </div>
                    </div>
                </div>
            }

            <!-- TIMELINE -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-bold">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i> @Localizer["Timeline"]
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <small class="text-muted">@Localizer["Created"]</small>
                        <div>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    @if (Model.SubmittedDate != null)
                    {
                        <div class="mb-2">
                            <small class="text-muted">@Localizer["Submitted"]</small>
                            <div>@Model.SubmittedDate?.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- APPROVE MODAL -->
@if (isApprover && Model.Status == InitiativeStatus.Processing)
{
    <div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="approveModalLabel">
                        <i class="fa-solid fa-circle-check text-success me-2"></i> @Localizer["Confirm Approval"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>@Html.Raw(string.Format(Localizer["Are you sure you want to {0} this initiative?"].Value, "<strong class=\"text-success\">" + Localizer["approve"].Value + "</strong>"))</p>
                    <div class="bg-light rounded p-3">
                        <small class="text-muted">@Localizer["Initiative"]:</small>
                        <div class="fw-semibold">@Model.Title</div>
                        <small class="text-muted">@Localizer["Code"]: @Model.InitiativeCode</small>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success">
                            <i class="fa-solid fa-check me-1"></i> @Localizer["Yes, Approve"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- REJECT MODAL -->
@if (isApprover && Model.Status == InitiativeStatus.Processing)
{
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="rejectModalLabel">
                        <i class="fa-solid fa-ban text-danger me-2"></i> @Localizer["Reject Initiative"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="bg-light rounded p-3 mb-3">
                            <small class="text-muted">@Localizer["Initiative"]:</small>
                            <div class="fw-semibold">@Model.Title</div>
                            <small class="text-muted">@Localizer["Code"]: @Model.InitiativeCode</small>
                        </div>

                        <div class="mb-3">
                            <label for="rejectReason" class="form-label fw-semibold">
                                @Localizer["Rejection Reason"] <span class="text-danger">*</span>
                            </label>
                            <textarea id="rejectReason" name="reason" class="form-control" rows="4" 
                                      placeholder="@Localizer["Enter the reason for rejection..."]" required></textarea>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="allowResubmit" name="allowResubmit" value="true" onchange="toggleDeadline()">
                            <label class="form-check-label fw-semibold" for="allowResubmit">
                                @Localizer["Allow resubmission"]
                            </label>
                            <div class="text-muted small">@Localizer["If checked, the author will be able to edit and resubmit before the deadline."]</div>
                        </div>

                        <div id="deadlineSection" class="mb-3" style="display: none;">
                            <label for="resubmitDeadline" class="form-label fw-semibold">
                                @Localizer["Resubmit Deadline"] <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="resubmitDeadline" name="deadline" class="form-control" 
                                   min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")">
                            <div class="text-muted small mt-1">@Localizer["The author must resubmit before this date."]</div>
                        </div>

                        <div class="alert alert-warning mb-0">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                            @Html.Raw(string.Format(Localizer["This will change the status from {0} to {1}."].Value,
                                "<span class=\"badge bg-info\">" + Localizer["Processing"].Value + "</span>",
                                "<span class=\"badge bg-danger\">" + Localizer["Rejected (SL)"].Value + "</span>"))
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-ban me-1"></i> @Localizer["Yes, Reject"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- REVOKE MODAL -->
@if (isApprover && Model.Status == InitiativeStatus.Approved)
{
    <div class="modal fade" id="revokeModal" tabindex="-1" aria-labelledby="revokeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="revokeModalLabel">
                        <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> @Localizer["Confirm Revoke"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>@Html.Raw(string.Format(Localizer["Are you sure you want to {0} the approval for this initiative?"].Value, "<strong class=\"text-warning\">" + Localizer["revoke"].Value + "</strong>"))</p>
                    <div class="bg-light rounded p-3">
                        <small class="text-muted">@Localizer["Initiative"]:</small>
                        <div class="fw-semibold">@Model.Title</div>
                        <small class="text-muted">@Localizer["Code"]: @Model.InitiativeCode</small>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <form asp-action="Revoke" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning text-white">
                            <i class="fa-solid fa-rotate-left me-1"></i> @Localizer["Yes, Revoke"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- UNDO REJECT MODAL -->
@if (isApprover && Model.Status == InitiativeStatus.Rejected_SL)
{
    <div class="modal fade" id="undoRejectModal" tabindex="-1" aria-labelledby="undoRejectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="undoRejectModalLabel">
                        <i class="fa-solid fa-undo text-secondary me-2"></i> @Localizer["Undo Rejection"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>@Localizer["Are you sure you want to undo the rejection? The initiative will go back to Processing status."]</p>
                    <div class="bg-light rounded p-3">
                        <small class="text-muted">@Localizer["Initiative"]:</small>
                        <div class="fw-semibold">@Model.Title</div>
                        <small class="text-muted">@Localizer["Code"]: @Model.InitiativeCode</small>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <form asp-action="UndoReject" asp-route-id="@Model.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary">
                            <i class="fa-solid fa-undo me-1"></i> @Localizer["Yes, Undo"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function toggleDeadline() {
        var cb = document.getElementById('allowResubmit');
        var section = document.getElementById('deadlineSection');
        var deadlineInput = document.getElementById('resubmitDeadline');
        if (cb.checked) {
            section.style.display = 'block';
            deadlineInput.required = true;
        } else {
            section.style.display = 'none';
            deadlineInput.required = false;
            deadlineInput.value = '';
        }
    }
</script>
